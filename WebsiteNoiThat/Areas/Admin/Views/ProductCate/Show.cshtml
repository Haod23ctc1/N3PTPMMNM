@model IEnumerable<Models.EF.Category>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<h2>Danh sách loại sản phẩm</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
}

<p>
    <a href="@Url.Action("Add", "ProductCate")" class="btn btn-primary" style="margin-top:10px;margin-bottom:10px;">Thêm loại sản phẩm</a>
</p>
<!-- DataTales Example -->
<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
        <table id="example" class="table table-striped table-bordered table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Mã loại sản phẩm</th>
                    <th>Tên loại sản phẩm</th>
                    <th>Diễn giải</th>
                    <th>Danh mục cha</th>
                    <th>Hành động</th>
                  
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    var parents = (Dictionary<int, string>)ViewBag.ParentNames;
                    var parentName = item.ParId.HasValue && item.ParId.Value != 0 && parents.ContainsKey(item.ParId.Value) ? parents[item.ParId.Value] : "—";
                    <tr class="Search">
                        <td> @item.CategoryId</td>
                        <td> @item.Name</td>
                        <td>@item.MetaTitle</td>
                        <td>@item.ParId (@parentName)</td>
                        <td>
                            <input type="button" class="btn btn-sm btn-primary" value="Sửa" onclick="location.href='/Admin/ProductCate/Edit?CategoryId=@item.CategoryId'" />
                            <form action="/Admin/ProductCate/Delete" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="CategoryId" value="@item.CategoryId" />
                                <input type="submit" class="btn btn-sm btn-danger" value="Xóa" onclick="return confirm('Bạn có chắc muốn xoá danh mục: @item.Name ?')" />
                            </form>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
    

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Content/DataTable/js/jquery.dataTables.min.js"></script>
<script src="~/Content/DataTable/js/dataTables.bootstrap.min.js"></script>

<script type="text/javascript">
    $('#example').DataTable();
</script>


