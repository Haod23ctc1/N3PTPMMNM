@model IEnumerable<Models.EF.User>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<h2>Danh sách nhân viên</h2>
<p><a href="@Url.Action("Add", "User")" class="btn btn-primary" style="margin-top:10px;margin-bottom:10px;">Thêm nhân viên</a></p>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
        <table id="example" class="table table-striped table-bordered table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Mã khách hàng</th>
                    <th>Họ tên</th>
                    <th>Địa chỉ</th>
                    <th>Số điện thoại</th>
                    <th>Tên đăng nhập</th>
                    <th>Mật khẩu</th>
                    <th>Email</th>
                    <th>Quyền</th>
                    <th>Trạng thái</th>
                    <th>Chỉnh sửa</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr class="Search">
                    <td> @item.UserId</td>
                    <td> @item.Name</td>
                    <td>@item.Address</td>
                    <td>@item.Phone</td>
                    <td>@item.Username</td>
                    <td>******</td>
                    <td>@item.Email</td>
                    <td>@item.GroupId</td>
                    <td>@item.Status</td>
                    <td width="120px;">
                        <a class="btn btn-sm btn-primary" href="@Url.Action("Edit", "User", new { UserId = item.UserId })">Sửa</a>
                        @using (Html.BeginForm("Delete", "User", FormMethod.Post, new { style = "display:inline" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("UserId", item.UserId)
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Bạn có chắc muốn xóa tài khoản @item.Username?');">Xóa</button>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>

<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Content/DataTable/js/jquery.dataTables.min.js"></script>
<script src="~/Content/DataTable/js/dataTables.bootstrap.min.js"></script>

<script type="text/javascript">
    $('#example').DataTable();
</script>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>

