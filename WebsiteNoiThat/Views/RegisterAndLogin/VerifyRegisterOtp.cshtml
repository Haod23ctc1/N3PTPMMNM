@{
    ViewBag.Title = "Xác thực email đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="max-width: 500px; margin: 40px auto;">
    <div class="panel panel-default">
        <div class="panel-heading text-center">
            <h3>XÁC THỰC EMAIL</h3>
            <p>Hệ thống đã gửi mã OTP xác nhận về địa chỉ email: <b>@ViewBag.Email</b></p>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm("VerifyRegisterOtp", "RegisterAndLogin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <div class="form-group">
                    <label>Nhập mã OTP gồm 6 chữ số:</label>
                    <input type="text" name="otpInput" class="form-control" placeholder="Nhập mã OTP..." required maxlength="6" />
                </div>
                <div class="form-group text-center">
                    <button type="submit" class="btn btn-primary btn-block">Xác nhận kích hoạt</button>
                    <a href="/RegisterAndLogin/Register" class="btn btn-link">Quay lại đăng ký</a>
                </div>
            }
        </div>
    </div>
</div>