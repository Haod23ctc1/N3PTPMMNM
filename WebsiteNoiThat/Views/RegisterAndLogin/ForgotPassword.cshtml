@using System.Configuration
@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = null;
    string siteKey = ConfigurationManager.AppSettings["GoogleReCaptchaSiteKey"] ?? "6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Khôi phục mật khẩu - Website Nội Thất</title>

    <!-- Thư viện Google reCAPTCHA (Hiển thị ngôn ngữ Tiếng Việt) -->
    <script src="https://www.google.com/recaptcha/api.js?hl=vi" async defer></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .card-box {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 820px;
            overflow: hidden;
            display: flex;
            flex-direction: row;
        }

        .left-banner {
            background: #f8faff;
            width: 42%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 25px;
            text-align: center;
            border-right: 1px solid #e3e6f0;
        }

        .icon-circle {
            width: 90px;
            height: 90px;
            background: #e8eefa;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            font-size: 42px;
        }

        .left-banner h3 {
            color: #333;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .left-banner p {
            color: #718096;
            font-size: 13.5px;
            line-height: 1.5;
        }

        .right-form {
            width: 58%;
            padding: 45px 40px;
        }

        .form-title {
            color: #2d3748;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
            text-align: center;
        }

        .form-desc {
            color: #718096;
            font-size: 13.5px;
            text-align: center;
            margin-bottom: 25px;
        }

        .input-group {
            margin-bottom: 18px;
        }

            .input-group label {
                display: block;
                font-size: 13px;
                font-weight: 600;
                color: #4a5568;
                margin-bottom: 6px;
            }

        .input-control {
            width: 100%;
            height: 46px;
            padding: 10px 14px;
            font-size: 14.5px;
            border: 1px solid #cbd5e0;
            border-radius: 8px;
            outline: none;
            transition: all 0.2s;
            background-color: #fcfdfe;
        }

            .input-control:focus {
                border-color: #4e73df;
                box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.2);
                background-color: #fff;
            }

        /* Canh giữa Google reCAPTCHA */
        .captcha-wrapper {
            display: flex;
            justify-content: center;
            margin: 20px 0;
        }

        .btn-submit {
            width: 100%;
            height: 46px;
            background: linear-gradient(180deg, #4e73df 0%, #2e59d9 100%);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(78, 115, 223, 0.35);
            transition: all 0.2s;
        }

            .btn-submit:hover {
                background: linear-gradient(180deg, #375a7f 0%, #224abe 100%);
            }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 14px;
            margin-bottom: 18px;
            text-align: center;
        }

        .alert-danger {
            background-color: #fff5f5;
            color: #c53030;
            border: 1px solid #feb2b2;
        }

        .alert-success {
            background-color: #f0fff4;
            color: #276749;
            border: 1px solid #9ae6b4;
        }

        .links-group {
            margin-top: 25px;
            padding-top: 15px;
            border-top: 1px solid #edf2f7;
            text-align: center;
        }

            .links-group a {
                color: #4e73df;
                text-decoration: none;
                font-size: 13.5px;
                font-weight: 600;
            }

                .links-group a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 768px) {
            .card-box {
                flex-direction: column;
            }

            .left-banner, .right-form {
                width: 100%;
                padding: 30px 20px;
            }

            /* Hỗ trợ reCAPTCHA không tràn màn hình mobile */
            .g-recaptcha {
                transform: scale(0.92);
                transform-origin: 0 0;
            }
        }
    </style>
</head>

<body>

    <div class="card-box">
        <!-- Cột đồ họa -->
        <div class="left-banner">
            <div class="icon-circle">🔐</div>
            <h3>Khôi phục tài khoản</h3>
            <p>Hệ thống sẽ gửi mã OTP xác thực về email để bạn tiến hành đặt lại mật khẩu mới.</p>
        </div>

        <!-- Cột form nhập -->
        <div class="right-form">
            <h2 class="form-title">Quên mật khẩu?</h2>
            <p class="form-desc">Nhập email của bạn để nhận mã xác thực OTP</p>

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">
                    <b>Thành công!</b><br />
                    @ViewBag.Success
                </div>
                <a href="@Url.Action("Login", "RegisterAndLogin")" style="text-decoration:none;">
                    <button type="button" class="btn-submit">Quay lại Đăng nhập ngay</button>
                </a>
            }
            else
            {
                using (Html.BeginForm("ForgotPassword", "RegisterAndLogin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(true, "")
                        </div>
                    }

                    <div class="input-group">
                        <label for="Email">Địa chỉ Email đã đăng ký:</label>
                        <input type="email" id="Email" name="Email" value="@ViewBag.Email" class="input-control" placeholder="vidu: khachhang@gmail.com" required autofocus />
                    </div>

                    <!-- Google reCAPTCHA thật -->
                    <div class="captcha-wrapper">
                        <div class="g-recaptcha" data-sitekey="@siteKey"></div>
                    </div>

                    <button type="submit" class="btn-submit">Gửi mã xác thực OTP</button>
                }

                <div class="links-group">
                    <a href="@Url.Action("Login", "RegisterAndLogin")">← Quay lại Đăng nhập</a>
                    <span style="color: #cbd5e0; margin: 0 8px;">|</span>
                    <a href="@Url.Action("Register", "RegisterAndLogin")">Tạo tài khoản mới</a>
                </div>
            }
        </div>
    </div>
</body>
</html>