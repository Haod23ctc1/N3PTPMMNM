@model WebsiteNoiThat.Models.LoginModel
@using System.Configuration
@{
    ViewBag.Title = "Login";
    Layout = null;
    string siteKey = ConfigurationManager.AppSettings["GoogleReCaptchaSiteKey"] ?? "6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Đăng nhập | Khách hàng</title>

    <!-- Custom fonts for this template-->
    <link href="~/Content/admin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/Content/admin/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        /* Căn giữa widget reCAPTCHA trên các kích thước màn hình */
        .captcha-wrapper {
            display: flex;
            justify-content: center;
            margin-bottom: 1rem;
        }
    </style>
</head>

<body class="bg-gradient-primary">

    <div class="container">

        <!-- Outer Row -->
        <div class="row justify-content-center">

            <div class="col-xl-10 col-lg-12 col-md-9">

                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <!-- Nested Row within Card Body -->
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block bg-login-image"></div>
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Xin chào quý khách!</h1>
                                    </div>

                                    @using (Html.BeginForm("Login", "RegisterAndLogin", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger text-center mb-3" })

                                        <fieldset>
                                            <div class="form-group">
                                                @Html.TextBoxFor(model => model.UserName, new { @class = "form-control form-control-user", @id = "exampleInputEmail", @placeholder = "Tên đăng nhập", @autofocus = "autofocus" })
                                                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger small pl-3" })
                                            </div>

                                            <div class="form-group">
                                                @Html.TextBoxFor(model => model.Password, new { @class = "form-control form-control-user", @id = "exampleInputPassword", @placeholder = "Mật khẩu", type = "password" })
                                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small pl-3" })
                                            </div>

                                            <!-- Widget Google "Tôi không phải là robot" chuẩn thực tế -->
                                            <div class="form-group captcha-wrapper">
                                                <div class="g-recaptcha" data-sitekey="@siteKey"></div>
                                            </div>

                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox small">
                                                    @Html.CheckBoxFor(model => model.RememberMe, new { @class = "custom-control-input", @id = "customCheck" })
                                                    <label class="custom-control-label" for="customCheck">Ghi nhớ đăng nhập</label>
                                                </div>
                                            </div>

                                            <button type="submit" class="btn btn-primary btn-user btn-block font-weight-bold">
                                                Đăng nhập
                                            </button>
                                            <hr>
                                            <a href="#" class="btn btn-google btn-user btn-block">
                                                <i class="fab fa-google fa-fw"></i> Đăng nhập với Google
                                            </a>
                                            <a href="#" class="btn btn-facebook btn-user btn-block">
                                                <i class="fab fa-facebook-f fa-fw"></i> Đăng nhập với Facebook
                                            </a>
                                        </fieldset>
                                    }

                                    <hr>
                                    <div class="text-center">
                                        <a class="small" href="@Url.Action("ForgotPassword", "RegisterAndLogin")">Quên mật khẩu?</a>
                                        <span class="mx-2 text-muted">|</span>
                                        <a class="small" href="@Url.Action("Register", "RegisterAndLogin")">Tạo tài khoản mới</a>
                                    </div>
                                    <div class="text-center mt-2">
                                        <a class="small text-secondary" href="/Admin/Login">Đăng nhập trang quản trị</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/Content/admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/Content/admin/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/Content/admin/js/sb-admin-2.min.js"></script>

    <!-- Thư viện Google reCAPTCHA (Hiển thị ngôn ngữ Tiếng Việt) -->
    <script src="https://www.google.com/recaptcha/api.js?hl=vi" async defer></script>

</body>
</html>