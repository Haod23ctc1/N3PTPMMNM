
@{
    var session = (UserLogin)Session[WebsiteNoiThat.Common.Commoncontent.user_sesion];
}

@if (session != null)
{
    <div class="dropdown account-dropdown">
        <a id="a_account" href="/RegisterAndLogin/ViewCurentUser"><img src="~/Content/client/assets/img/round-account-button-with-user-inside.png" /></a>
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Mở menu tài khoản" title="@session.Username">
            <span class="sr-only">Mở menu tài khoản</span>
        </button>
        <ul class="dropdown-menu dropdown-user" id="account_dropdown">
        <li>
            <a href="/RegisterAndLogin/ViewCurentUser"><i class="fa fa-user"></i> Thông tin tài khoản</a>
        </li>
        <li>
            <a href="/RegisterAndLogin/ChangePassword"><i class="fa fa-key"></i> Đổi mật khẩu</a>
        </li>
        <li>
            <a href="/IdentityVerification/Submit">
                <svg class="identity-verification-icon" viewBox="0 0 20 16" aria-hidden="true" focusable="false">
                    <rect x="1" y="1" width="18" height="14" rx="2"></rect>
                    <circle cx="6" cy="6" r="2"></circle>
                    <path d="M3.5 12c.5-1.6 1.3-2.3 2.5-2.3s2 .7 2.5 2.3M12 5h4M12 8h4M12 11h2"></path>
                </svg>
                Xác minh danh tính
            </a>
        </li>
        <li>
            <a href="/don-hang-cua-toi"><i class="fa fa-file-text-o"></i> Đơn hàng của tôi</a>
        </li>
        <li>
            <a href="/Cart/HistoryCart"><i class="fa fa-hourglass"></i> Lịch sử mua hàng</a>
        </li>
        <li>
            <a href="/danh-sach-yeu-thich"><i class="fa fa-heart"></i> Danh sách yêu thích</a>
        </li>
        <li>
            <a href=""><i class="fa fa-credit-card"></i> Thẻ tích điểm:@ViewBag.Card </a>
        </li>

        <li>
            <a href="@Url.Action("Card", "RegisterAndLogin", new { @UserId=session.UserId })"><i class="fa fa-sign-in"></i> Đăng ký thẻ tích điểm</a>
        </li>
        <li>
            <a href="/RegisterAndLogin/Logout"><i class="fa fa-sign-out"></i> Đăng xuất</a>
        </li>

        </ul>
    </div>
}
else
{
    <a id="a_account" href="/RegisterAndLogin/Login"><img src="~/Content/client/assets/img/round-account-button-with-user-inside.png" /></a>
}
