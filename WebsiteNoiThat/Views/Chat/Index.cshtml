@model List<Models.EF.ChatMessage>
@{
    ViewBag.Title = "Tin nhắn & Hỗ trợ | Khách hàng";
}

<div class="container" style="min-height: 480px; padding-bottom: 40px;">
    <div class="row" style="margin-top: 20px;">
        <div class="col-md-10 col-md-offset-1">

            <h2 style="color: #4e73df; border-bottom: 2px solid #4e73df; padding-bottom: 8px;">
                <i class="fa fa-comments-o"></i> Tin nhắn &amp; Hỗ trợ
            </h2>
            @if (ViewBag.ChatError != null)
            {
                <div class="alert alert-danger">@ViewBag.ChatError</div>
            }

            @if (!(bool)ViewBag.Identified)
            {
                <!--o Chưa biết danh tính: tra cứu chat bằng Email + Phone -->
                <p>Nhập <b>Email</b> và <b>Số điện thoại</b> của tài khoản để xem tin nhắn hệ thống (gồm mã OTP khi đăng ký / khi lấy lại mật khẩu).</p>
                using (Html.BeginForm("Find", "Chat", FormMethod.Post, new { @class = "form-inline", style = "margin-bottom: 25px;" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="email" name="email" class="form-control" placeholder="Email tài khoản" style="width: 260px;" required />
                    </div>
                    <div class="form-group" style="margin-right: 10px;">
                        <input type="text" name="phone" class="form-control" placeholder="Số điện thoại (VD: 0901234567)" style="width: 240px;" required />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Xem tin nhắn</button>
                }
            }
            else
            {
                <p style="margin-bottom: 15px;">
                    <i class="fa fa-user-circle"></i>
                    Xin chào <b>@(ViewBag.WelcomeName ?? ViewBag.ThreadEmail)</b> — dưới đây là tin nhắn giữa bạn và hệ thống.
                    Đừng chia sẻ mã OTP cho bất kỳ ai!
                </p>
            }

            @if (!Html.ViewData.ModelState.IsValid)
            {
                foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="alert alert-danger">@err.ErrorMessage</div>
                }
            }

            <!-- Khung hội thoại -->
            <div id="chat_box" style="background: #f8faff; border: 1px solid #e3e6f0; border-radius: 10px; padding: 15px; max-height: 420px; overflow-y: auto; margin-bottom: 15px;">
                @if (Model == null || Model.Count == 0)
                {
                    <p style="color: #858796; text-align: center; padding: 30px 0;">
                        <i class="fa fa-inbox"></i> Chưa có tin nhắn nào.
                    </p>
                }
                else
                {
                    foreach (var m in Model)
                    {
                        if (m.IsSystem)
                        {
                            <!-- Tin nhắn hệ thống (góc trái) -->
                            <div style="margin-bottom: 12px;">
                                <div style="font-size: 12px; color: #858796;">
                                    <i class="fa fa-cog"></i> @(m.Sender ?? "Hệ thống") — @m.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div style="background: #e8eefa; border: 1px solid #d1d3e2; border-radius: 8px 8px 8px 0; padding: 10px 14px; max-width: 75%;">
                                    @Html.Raw(Html.Encode(m.Content).Replace("\n", "<br/>"))
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Tin nhắn khách (góc phải) -->
                            <div style="margin-bottom: 12px; text-align: right;">
                                <div style="font-size: 12px; color: #858796;">
                                    @m.CreatedDate.ToString("dd/MM/yyyy HH:mm") — @(m.Sender ?? "Bạn")
                                </div>
                                <div style="background: #4e73df; color: #fff; border-radius: 8px 8px 0 8px; padding: 10px 14px; max-width: 75%; display: inline-block; text-align: left;">
                                    @Html.Raw(Html.Encode(m.Content).Replace("\n", "<br/>"))
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            @if ((bool)ViewBag.Identified && Session[WebsiteNoiThat.Common.Commoncontent.user_sesion] != null)
            {
                using (Html.BeginForm("Send", "Chat", FormMethod.Post, new { @class = "form-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group" style="width: 85%;">
                        <input type="text" name="content" class="form-control" placeholder="Nhập tin nhắn cần hỗ trợ..." style="width: 100%;" maxlength="4000" required />
                    </div>
                    <button type="submit" class="btn btn-primary" style="margin-left: 8px;"><i class="fa fa-paper-plane"></i> Gửi</button>
                }
            }
            else if ((bool)ViewBag.Identified)
            {
                <p style="color: #858796;"><i class="fa fa-info-circle"></i> <a href="/RegisterAndLogin/Login">Đăng nhập</a> để gửi tin nhắn cho bộ phận hỗ trợ.</p>
            }

        </div>
    </div>
</div>

<!--o Tu dong cuon xuong cuoi khung chat -->
<script>
    (function () {
        var box = document.getElementById('chat_box');
        if (box) { box.scrollTop = box.scrollHeight; }
    })();
</script>
