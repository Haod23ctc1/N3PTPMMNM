@model Models.EF.News
@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Noidungmenu{
    <div class="ct-boxmain row m0" style="text-align:left;">
        <div class="col-xs-12" style="padding:10px 20px;">
            <h2 class="entry-title" style="margin-top:10px;">@Model.Title</h2>
            <p style="color:#888;font-size:13px;">
                <i class="fa fa-calendar" aria-hidden="true"></i>
                @(Model.DateUpdate.HasValue ? Model.DateUpdate.Value.ToString("dd/MM/yyyy") : "")
            </p>
            <hr style="margin:10px 0 15px 0;" />
            <div class="text-center" style="padding:10px 0 20px 0;">
                <img src="@Url.Content("~/image/" + Model.Photo)" alt="@Model.Title" style="max-width:600px;width:100%;height:auto;border:1px solid #eee;" />
            </div>
            <div class="entry-detail" style="font-size:14px;line-height:1.8;color:#444;">
                @*@Model.Detail là nội dung do quản trị soạn nên vẫn được encode chống XSS, giữ nguyên dấu xuống dòng*@
                @Html.Raw(Html.Encode(Model.Detail ?? "").Replace("\n", "<br/>"))
            </div>
            <hr style="margin:20px 0 15px 0;" />
            <p>
                <a href="/tin-tuc" class="btn btn-default"><i class="fa fa-angle-double-left" aria-hidden="true"></i> Về trang tin tức</a>
            </p>
        </div>

        @{
            var related = new Models.DAO.NewsDao().ListAll().Where(n => n.NewsId != Model.NewsId).Take(3).ToList();
            if (related.Count > 0)
            {
                <h4 class="col-xs-12" style="border-bottom:1px solid #eee;padding:10px 0;">Tin liên quan</h4>
                foreach (var item in related)
                {
                    <div class="col-xs-6 col-sm-4 col-md-4 p5">
                        <div class="boxsp">
                            <div class="imgsp">
                                <a href="/tin-tuc/@item.NewsId" title="@item.Title"><img class="imgproduct" style="width:100%;height:150px;object-fit:cover;" src="@Url.Content("~/image/" + item.Photo)" /></a>
                            </div>
                            <div class="namesp">
                                <a href="/tin-tuc/@item.NewsId">@item.Title</a>
                            </div>
                            <div style="padding:0 10px 8px 10px;color:#777;font-size:12px;">
                                <i class="fa fa-calendar" aria-hidden="true"></i>
                                @(item.DateUpdate.HasValue ? item.DateUpdate.Value.ToString("dd/MM/yyyy") : "")
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
}
