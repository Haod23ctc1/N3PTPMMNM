@model List<WebsiteNoiThat.Models.CartItem>

<div class="cart">
    <div class="discart">
        @*<a>@Model.Count</a>*@
        <a class="dot"><span style="font-weight: bold; color: red;">@Model.Count</span></a>

        @*<span class="dot"><a class="count_products_cart">@Model.Count</a></span>*@
    </div>
    <div class="top-cart-content" style="border-radius:5px;">
        <a style="font-weight:bold">Giỏ hàng</a>
        <br/>
            @foreach(var item in Model)
            {
            <a>@item.Product.Name x </a>@item.Quantity<br/>
            }
        @if (Model.Count > 0)
        {
            <br/>
            <span>Tổng tiền: <b style="color:red">@string.Format("{0:N0}", (double)ViewBag.Total)₫</b></span>
            <br/>
            <a href="/gio-hang" style="text-decoration:underline">Xem giỏ hàng</a>
            <text>|</text>
            <a href="/thanh-toan" style="text-decoration:underline">Thanh toán</a>
        }
        else
        {
            <br/>
            <span>Giỏ hàng trống</span>
            <br/>
            <a href="/" style="text-decoration:underline">Tiếp tục mua hàng</a>
        }
    </div>
</div>

<style>
    .dot {
        height: 21px;
        width: 21px;
        background-color: gainsboro;
        border-radius: 30%;
        display: block;
    }
</style>
