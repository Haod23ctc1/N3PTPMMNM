@{
    ViewBag.Title = "Chính sách thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Noidungmenu{
    <div class="ct-boxmain row m0" style="text-align:left;">
        <div class="col-xs-12" style="padding:10px 20px;">
            <h2 style="margin-top:10px;">CHÍNH SÁCH THANH TOÁN</h2>
            <hr style="margin:10px 0 15px 0;" />

            <p style="font-size:14px;line-height:1.8;color:#444;">
                NOITHATGO.VN hỗ trợ quý khách 3 hình thức thanh toán an toàn và linh hoạt:
            </p>

            <div class="row" style="margin-top:15px;">
                <div class="col-sm-4 text-center" style="padding:20px 10px;border:1px solid #eee;">
                    <i class="fa fa-money" style="font-size:36px;color:#5cb85c;" aria-hidden="true"></i>
                    <h5 style="font-weight:bold;">1. TIỀN MẶT</h5>
                    <p style="font-size:13px;color:#777;text-align:left;">
                        Thanh toán trực tiếp khi nhận hàng (COD) với nội thành Hà Nội.
                        Quý khách kiểm tra hàng trước khi thanh toán.
                    </p>
                </div>
                <div class="col-sm-4 text-center" style="padding:20px 10px;border:1px solid #eee;">
                    <i class="fa fa-university" style="font-size:36px;color:#4a90d2;" aria-hidden="true"></i>
                    <h5 style="font-weight:bold;">2. CHUYỂN KHOẢN</h5>
                    <p style="font-size:13px;color:#777;text-align:left;">
                        Chuyển khoản ngân hàng hoặc qua ví điện tử.
                        Đặt cọc <b>30%</b> giá trị đơn hàng, thanh toán phần còn lại khi nhận hàng.
                    </p>
                </div>
                <div class="col-sm-4 text-center" style="padding:20px 10px;border:1px solid #eee;">
                    <i class="fa fa-credit-card" style="font-size:36px;color:#f0ad4e;" aria-hidden="true"></i>
                    <h5 style="font-weight:bold;">3. TRẢ GÓP 0%</h5>
                    <p style="font-size:13px;color:#777;text-align:left;">
                        Trả góp 0% lãi suất qua thẻ tín dụng (3 - 12 tháng) cho đơn hàng
                        từ <b>50.000.000₫</b> trở lên.
                    </p>
                </div>
            </div>

            <h4 style="font-weight:bold;margin-top:20px;">Lưu ý</h4>
            <ul style="font-size:14px;line-height:2;color:#444;">
                <li>Đơn hàng chỉ được chốt sau khi nhân viên xác nhận qua điện thoại/email.</li>
                <li>Chúng tôi sẽ xuất hóa đơn VAT theo yêu cầu của quý khách.</li>
                <li>Mọi thắc mắc về thanh toán xin liên hệ hotline <b>0968 012 687</b>.</li>
            </ul>

            <p style="margin-top:20px;">
                <a href="/" class="btn btn-default"><i class="fa fa-angle-double-left" aria-hidden="true"></i> Về trang chủ</a>
            </p>
        </div>
    </div>
}
