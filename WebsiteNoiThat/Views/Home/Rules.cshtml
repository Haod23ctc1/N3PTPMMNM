@{
    ViewBag.Title = "Chính sách & Quy định";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Noidungmenu{
    <div class="ct-boxmain row m0" style="text-align:left;">
        <div class="col-xs-12" style="padding:10px 20px;">
            <h2 style="margin-top:10px;">CHÍNH SÁCH & QUY ĐỊNH</h2>
            <hr style="margin:10px 0 15px 0;" />

            <h4 style="font-weight:bold;">1. Quy định chung</h4>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                Khi sử dụng website NOITHATGO.VN, quý khách đồng ý với các quy định sau:
                thông tin đăng ký tài khoản phải chính xác; không sử dụng website cho các hành vi
                vi phạm pháp luật; mọi giao dịch trên website đều được xác nhận qua số điện thoại
                hoặc email của quý khách.
            </p>

            <h4 style="font-weight:bold;">2. Quy định về giá</h4>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                Giá sản phẩm hiển thị trên website là giá bán lẻ chưa bao gồm chi phí vận chuyển và
                lắp đặt. Giá khuyến mãi chỉ áp dụng trong thời gian hiển thị trên sản phẩm.
                Giá có thể thay đổi theo chất liệu và kích thước đặt riêng.
            </p>

            <h4 style="font-weight:bold;">3. Quy định về đổi trả</h4>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                Quý khách được đổi trả sản phẩm trong vòng <b>7 ngày</b> kể từ ngày nhận hàng nếu sản phẩm
                bị lỗi do nhà sản xuất, nứt vỡ khi vận chuyển hoặc không đúng như mô tả. Sản phẩm đổi trả
                cần giữ nguyên hiện trạng, kèm hóa đơn mua hàng.
            </p>

            <h4 style="font-weight:bold;">4. Quy định về bảo mật</h4>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                Thông tin cá nhân của quý khách (họ tên, địa chỉ, số điện thoại, email) chỉ được sử dụng
                cho mục đích xử lý đơn hàng và hỗ trợ khách hàng. Chúng tôi cam kết không chia sẻ thông tin
                của quý khách cho bên thứ ba.
            </p>

            <p style="margin-top:20px;">
                <a href="/" class="btn btn-default"><i class="fa fa-angle-double-left" aria-hidden="true"></i> Về trang chủ</a>
            </p>
        </div>
    </div>
}
