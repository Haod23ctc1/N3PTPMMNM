@{
    ViewBag.Title = "Giới thiệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Noidungmenu{
    <div class="ct-boxmain row m0" style="text-align:left;">
        <div class="col-xs-12" style="padding:10px 20px;">
            <h2 style="margin-top:10px;">GIỚI THIỆU VỀ NOITHATGO.VN</h2>
            <hr style="margin:10px 0 15px 0;" />

            <p style="font-size:14px;line-height:1.8;color:#444;">
                <b>NOITHATGO.VN</b> là website bán nội thất gỗ cao cấp, chuyên cung cấp các bộ sản phẩm
                cho <b>phòng ăn, phòng khách, phòng ngủ, phòng thờ, phòng làm việc</b> cùng các dòng
                <b>phong cách Havana</b> và <b>phong cách Korea</b>. Toàn bộ sản phẩm được làm từ gỗ tự nhiên,
                chạm khắc tỉ mỉ theo nghề truyền thống làng nghề Đông Kỵ (Gia Lâm, Hà Nội).
            </p>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                Với hơn 10 năm kinh nghiệm trong nghề đồ gỗ, chúng tôi cam kết:
            </p>
            <ul style="font-size:14px;line-height:2;color:#444;">
                <li><i class="fa fa-check" aria-hidden="true" style="color:#4a90d2;"></i> <b>Gỗ thật 100%</b> - gỗ dẫm tự nhiên, bảo hành ngấu gỗ.</li>
                <li><i class="fa fa-check" aria-hidden="true" style="color:#4a90d2;"></i> <b>Chạm khắc thủ công</b> - từng sản phẩm là một tác phẩm của nghệ nhân.</li>
                <li><i class="fa fa-check" aria-hidden="true" style="color:#4a90d2;"></i> <b>Giá xuất xưởng</b> - mua trực tiếp không qua trung gian.</li>
                <li><i class="fa fa-check" aria-hidden="true" style="color:#4a90d2;"></i> <b>Vận chuyển lắp đặt tận nhà</b> toàn quốc.</li>
                <li><i class="fa fa-check" aria-hidden="true" style="color:#4a90d2;"></i> <b>Đổi trả trong 7 ngày</b> nếu sản phẩm lỗi do nhà sản xuất.</li>
            </ul>

            <div class="row" style="margin-top:20px;">
                <div class="col-sm-4 text-center" style="padding:15px;border:1px solid #eee;">
                    <i class="fa fa-truck" style="font-size:32px;color:#d9534f;" aria-hidden="true"></i>
                    <h5 style="font-weight:bold;">GIAO HÀNG TOÀN QUỐC</h5>
                    <p style="font-size:12px;color:#777;">Vận chuyển nhanh, lắp đặt tận nơi</p>
                </div>
                <div class="col-sm-4 text-center" style="padding:15px;border:1px solid #eee;">
                    <i class="fa fa-shield" style="font-size:32px;color:#5cb85c;" aria-hidden="true"></i>
                    <h5 style="font-weight:bold;">BẢO HÀNH 5 NĂM</h5>
                    <p style="font-size:12px;color:#777;">Cam kết gỗ thật - ngấu gỗ</p>
                </div>
                <div class="col-sm-4 text-center" style="padding:15px;border:1px solid #eee;">
                    <i class="fa fa-phone" style="font-size:32px;color:#f0ad4e;" aria-hidden="true"></i>
                    <h5 style="font-weight:bold;">HỖ TRỢ 24/7</h5>
                    <p style="font-size:12px;color:#777;">Hotline: <b>0968 012 687</b></p>
                </div>
            </div>
        </div>
    </div>
}
