@{
    ViewBag.Title = "Chính sách vận chuyển";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Noidungmenu{
    <div class="ct-boxmain row m0" style="text-align:left;">
        <div class="col-xs-12" style="padding:10px 20px;">
            <h2 style="margin-top:10px;">CHÍNH SÁCH VẬN CHUYỂN</h2>
            <hr style="margin:10px 0 15px 0;" />

            <h4 style="font-weight:bold;">1. Phạm vi giao hàng</h4>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                NOITHATGO.VN giao hàng toàn quốc. Với nội thành Hà Nội và TP. Hồ Chí Minh, hàng được
                giao trong vòng <b>1 - 3 ngày làm việc</b>. Với các tỉnh thành khác, thời gian giao hàng
                từ <b>3 - 7 ngày làm việc</b> tùy phương thức vận chuyển và khu vực.
            </p>

            <h4 style="font-weight:bold;">2. Chi phí vận chuyển</h4>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                - Nội thành Hà Nội: <b>Miễn phí</b> cho đơn hàng từ 20.000.000₫ trở lên.<br />
                - Các tỉnh khác: tính theo cước phí đơn vị vận chuyển, báo giá cụ thể trước khi xác nhận đơn.<br />
                - Quý khách được thông báo chính xác chi phí qua điện thoại/email trước khi chốt đơn.
            </p>

            <h4 style="font-weight:bold;">3. Lắp đặt tại nhà</h4>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                Đội ngũ kỹ thuật của chúng tôi hỗ trợ lắp đặt tận nhà trong nội thành Hà Nội.
                Với các tỉnh, sản phẩm được đóng gói dàn sẵn để lắp đặt đơn giản kèm hướng dẫn chi tiết.
            </p>

            <h4 style="font-weight:bold;">4. Kiểm tra hàng khi nhận</h4>
            <p style="font-size:14px;line-height:1.8;color:#444;">
                Quý khách vui lòng kiểm tra kỹ sản phẩm trước khi ký nhận. Trường hợp phát hiện nứt vỡ,
                mòn nhạt hoặc sai mẫu, quý khách vui lòng <b>không ký nhận</b> và liên hệ ngay hotline
                <b>0968 012 687</b> để được đổi hàng miễn phí.
            </p>

            <p style="margin-top:20px;">
                <a href="/" class="btn btn-default"><i class="fa fa-angle-double-left" aria-hidden="true"></i> Về trang chủ</a>
            </p>
        </div>
    </div>
}
